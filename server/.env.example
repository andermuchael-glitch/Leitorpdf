# Optional protection for the private TTS API.
# Send: Authorization: Bearer <TTS_API_TOKEN>
TTS_API_TOKEN=

# Where voice references and generated audio are stored.
VOICE_DIR=/data/voices
AUDIO_DIR=/data/audio

# Chatterbox model: v3 is the current multilingual checkpoint.
CHATTERBOX_MODEL=v3

# Use CUDA on a GPU server. The app falls back to CPU when CUDA is unavailable.
TTS_DEVICE=auto
